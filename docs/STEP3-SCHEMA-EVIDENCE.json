  "constraints": [
    {
      "conname": "ai_draft_runs_article_id_fkey",
      "contype": "f",
      "convalidated": true,
      "definition": "FOREIGN KEY (article_id) REFERENCES newsroom.articles(id)"
    },
    {
      "conname": "ai_draft_runs_attempts_check",
      "contype": "c",
      "convalidated": true,
      "definition": "CHECK (((attempts >= 1) AND (attempts <= 2)))"
    },
    {
      "conname": "ai_draft_runs_attempts_not_null",
      "contype": "n",
      "convalidated": true,
      "definition": "NOT NULL attempts"
    },
    {
      "conname": "ai_draft_runs_category_check",
      "contype": "c",
      "convalidated": true,
      "definition": "CHECK ((category = ANY (ARRAY['politics'::text, 'entertainment'::text, 'technology'::text])))"
    },
    {
